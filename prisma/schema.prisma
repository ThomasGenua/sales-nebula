generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ───

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  active    Boolean  @default(true)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership relations
  assignedDeals      Deal[]     @relation("DealOwner")
  assignedLeads      Lead[]     @relation("LeadAssignee")
  assignedCases      Case[]     @relation("CaseAssignee")
  assignedActivities Activity[] @relation("ActivityAssignee")
  auditLogs          AuditLog[]
  caseComments       CaseComment[]
  notifications      Notification[]
  chatterPosts       ChatterPost[]
  chatterComments    ChatterComment[]
  approvalRequests   ApprovalRequest[] @relation("ApprovalRequester")
  approvalSteps      ApprovalStep[]    @relation("ApprovalApprover")
  territories        TerritoryMember[]
  forecasts          Forecast[]         @relation("ForecastUser")
  ownedForecasts     Forecast[]         @relation("ForecastOwner")
  ownedCampaigns     Campaign[]         @relation("CampaignOwner")
  knowledgeArticles  KnowledgeArticle[] @relation("ArticleAuthor")
  reports            Report[]           @relation("ReportsCreated")
  // Written by the routes, never migrated until now.
  contactId String?
  isPortalUser Boolean   @default(false)
  // Shown on the profile page; stamped at each sign-in.
  lastLoginAt DateTime?
  @@index([roleId])
  teamMemberships TeamMember[] @relation("TeamMembers")
  deployments    Deployment[]      @relation
  agentPresences AgentPresence[]   @relation("AgentPresenceUser")

}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module String // contacts, leads, deals, etc.
  level  String // none, read, edit, full

  @@unique([roleId, module])
}

// ─── CRM CORE ───

model Contact {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  mobile      String?
  mobilePhone String?
  title       String?
  department  String?
  status      String   @default("Active")
  source      String?
  leadSource  String?
  address     String?
  city        String?
  state       String?
  country     String?
  description String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  deals        Deal[]
  activities   Activity[]
  emails       Email[]
  cases        Case[]
  documents    Document[]
  quotes       Quote[]
  invoices     Invoice[]
  customValues CustomFieldValue[]
  campaignRecipients CampaignRecipient[]
  contracts    Contract[]  @relation("ContractContact")
  // Written by the routes, never migrated until now.
  mergedIntoId String?
  @@index([accountId])
  @@index([ownerId])
}

model Lead {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String
  title       String?
  source      String?  @default("Website")
  status      String   @default("New")
  rating      String?
  score       Int      @default(50)
  value       Float    @default(0)
  address     String?
  city        String?
  state       String?
  country     String?
  description String?
  assignedId  String?
  assignedTo  User?    @relation("LeadAssignee", fields: [assignedId], references: [id])
  ownerId     String?
  convertedAt DateTime?
  contactId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customValues CustomFieldValue[]
  campaignRecipients CampaignRecipient[]
  @@index([ownerId])
  @@index([assignedId])
}

model Deal {
  id          String   @id @default(uuid())
  name        String
  stage       String   @default("Qualification") // Qualification, Discovery, Proposal, Negotiation, Closed Won, Closed Lost
  value       Float    @default(0)
  probability Int      @default(10)
  closeDate   DateTime?
  description String?
  source      String?
  competitors Json?
  lossReason  String?
  ownerId     String?
  owner       User?    @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities   Activity[]
  emails       Email[]
  cases        Case[]
  quotes       Quote[]
  documents    Document[]
  customValues CustomFieldValue[]
  forecastItems ForecastItem[]
  approvalRequests ApprovalRequest[]
  stageHistory DealStageHistory[]
  lineItems    DealLineItem[]
  dealTeams       DealTeam[]
  contactRoles    DealContactRole[]
  splits          DealSplit[]
  fieldHistory    DealHistory[]
  dealCompetitors DealCompetitor[]
  type String?
  deletedAt   DateTime?
  // Written by the routes, never migrated until now.
  partnerId String?

  @@index([accountId])
  @@index([contactId])
  @@index([ownerId])
}

// Track deal stage changes for analytics
model DealStageHistory {
  id        String   @id @default(uuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage String?
  toStage   String
  changedById String?
  duration  Int?     // Days spent in previous stage
  createdAt DateTime @default(now())
}

model Account {
  id             String   @id @default(uuid())
  name           String
  industry       String?
  type           String   @default("Prospect") // Prospect, Customer, Partner, Former
  revenue        Float    @default(0)
  annualRevenue  Float?
  employees      Int      @default(0)
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?
  billing        String?
  billingCity    String?
  billingState   String?
  billingCountry String?
  billingStreet  String?
  billingZip     String?
  rating         Int      @default(0) // 0-5
  description    String?
  parentId       String?
  ownerId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  cases        Case[]
  quotes       Quote[]
  invoices     Invoice[]
  documents    Document[]
  customValues CustomFieldValue[]
  territories  TerritoryAccount[]
  contracts     Contract[]
  orders        Order[]
  entitlements  Entitlement[]
  accountTeams  AccountTeam[]
  subscriptions Subscription[]
  // Written by the routes, never migrated until now.
  createdById String?
  @@index([ownerId])
  deletedAt   DateTime?

}

model Activity {
  id         String    @id @default(uuid())
  type       String    // Call, Meeting, Email, Task
  subject    String
  date       DateTime @default(now())
  priority   String    @default("Medium") // High, Medium, Low
  status     String    @default("Scheduled") // Scheduled, Pending, Completed
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignedId String?
  assignedTo   User?    @relation("ActivityAssignee", fields: [assignedId], references: [id])
  ownerId      String?
  completedAt  DateTime?
  dueDate      DateTime?
  duration     Int?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customValues CustomFieldValue[]
  // Written by the routes, never migrated until now.
  result String?

  @@index([contactId])
  @@index([dealId])
  @@index([accountId])
  @@index([assignedId])
  deletedAt   DateTime?

}

// ─── EMAIL ───

model Email {
  id        String   @id @default(uuid())
  subject   String
  body      String
  status    String   @default("draft") // draft, sent
  opened    Boolean  @default(false)
  openedAt  DateTime?
  sentAt    DateTime?
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from       String?
  to         String?
  toEmail    String?
  toName     String?
  clicked    Boolean  @default(false)
  templateId String?

  @@index([contactId])
  @@index([dealId])
  deletedAt   DateTime?

}

model EmailTemplate {
  id      String @id @default(uuid())
  name    String
  subject String
  body    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category String?
}

// ─── CASES ───

model Case {
  id          String   @id @default(uuid())
  caseNumber  String   @unique
  subject     String
  description String?
  type        String   @default("Problem") // Problem, Bug, Feature, Question
  status      String   @default("New") // New, Open, Escalated, Resolved, Closed
  priority    String   @default("Medium") // High, Medium, Low
  resolution  String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignedId  String?
  assignedTo  User?    @relation("CaseAssignee", fields: [assignedId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments  CaseComment[]
  documents Document[]
  customValues CustomFieldValue[]
  closedAt    DateTime?
  origin      String?
  emailThreadId      String?
  lastEmailMessageId String?
  emailCount         Int       @default(0)
  lastEmailAt        DateTime?
  contactEmail       String?
  contactPhone       String?
  webFormName        String?
  product            String?
  customFields       Json?
  ownerId            String?
  // Written by the routes, never migrated until now.
  escalatedAt DateTime?
  escalationReason String?
  isEscalated Boolean   @default(false)
  satisfactionComment String?
  satisfactionRating Int?
  slaBreached Boolean   @default(false)
  slaDueAt DateTime?
  slaStatus String?
  // The asset's service history and the entitlement's usage count cases by these.
  assetId       String?
  entitlementId String?

  @@index([accountId])
  @@index([contactId])
  @@index([assignedId])
  @@index([assetId])
  @@index([entitlementId])
  deletedAt   DateTime?

}

model CaseComment {
  id       String   @id @default(uuid())
  caseId   String
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Null when a customer wrote it by email; authorEmail says who.
  authorId String?
  author   User?    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  text      String
  isInternal Boolean @default(false)
  isPublic    Boolean @default(false)
  authorEmail String?

  @@index([caseId])
  @@index([authorId])
}

// ─── DOCUMENTS ───

model Document {
  id            String   @id @default(uuid())
  name          String   // Display name
  fileName      String?  // Original filename
  fileSize      Int      @default(0) // Bytes
  mimeType      String?
  filePath      String?  // Actual file path on disk/S3
  category      String   @default("General")
  description   String?
  version       Int      @default(1)
  tags          String[] @default([])
  linkedModule  String?  // Polymorphic: contacts, deals, etc.
  linkedId      String?
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  caseId        String?
  case          Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Written by the routes, never migrated until now.
  accessLevel String?
  createdById String?
  downloadCount Int       @default(0)
  isTemplate Boolean   @default(false)
  sharedWith Json?

  @@index([contactId])
  @@index([dealId])
  @@index([accountId])
  @@index([caseId])
  deletedAt   DateTime?

}

// ─── CAMPAIGNS ───

model Campaign {
  id            String   @id @default(uuid())
  name          String
  type          String   @default("Email") // Email, Social, Event, Webinar, Direct Mail
  status        String   @default("Planned") // Planned, Active, Sent, Paused, Completed
  budget        Float    @default(0)
  actualCost    Float    @default(0)
  startDate     DateTime?
  endDate       DateTime?
  description     String?
  expectedRevenue Float?
  ownerId       String?
  owner         User?    @relation("CampaignOwner", fields: [ownerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipients CampaignRecipient[]
  targetLists TargetList[]
  // Written by the routes, never migrated until now.
  createdById String?

  @@index([ownerId])
  deletedAt   DateTime?


  campaignMembers CampaignMember[] @relation("CampaignMembers")
}

model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status     String   @default("pending") // pending, sent, delivered, opened, clicked, bounced
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  email  String?

  @@index([campaignId])
  @@index([contactId])
  @@index([leadId])
}

model TargetList {
  id         String   @id @default(uuid())
  name       String
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  description String?
  memberCount Int @default(0)
}

// ─── PRODUCTS / QUOTES / INVOICES ───

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  category    String   @default("License")
  price       Float    @default(0)
  cost        Float    @default(0)
  description String?
  unit        String   @default("each")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteItems   QuoteItem[]
  invoiceItems InvoiceItem[]
  orderItems   OrderItem[]
  subscriptions Subscription[] @relation("SubscriptionProduct")
  quoteLineItems QuoteLineItem[] @relation("QuoteLineProducts")
  bundleItems  ProductBundleItem[] @relation("BundleProduct")
  inBundles    ProductBundleItem[] @relation("BundleChild")
  discountSchedules ProductDiscountSchedule[]
  pricebookEntries PricebookEntry[]
  dealLineItems    DealLineItem[]
  deletedAt   DateTime?
  // Stock levels for the inventory report; unset means not tracked.
  quantityOnHand  Int?
  reorderPoint    Int?
  reorderQuantity Int?

}

model Quote {
  id         String   @id @default(uuid())
  number     String   @unique
  status     String   @default("Draft") // Draft, Sent, Accepted, Rejected
  total      Float    @default(0)
  discount   Float    @default(0)
  tax        Float    @default(0)
  notes      String?
  validUntil DateTime?
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items    QuoteItem[]
  lineItems QuoteLineItem[]
  invoices Invoice[]
  subtotal   Float    @default(0)
  terms      String?
  // Written by the routes, never migrated until now.
  discountReason String?
  orderId String?
  submittedAt DateTime?

  @@index([dealId])
  @@index([accountId])
  @@index([contactId])
  deletedAt   DateTime?

  totalAmount     Float    @default(0)
  quoteNumber     String?
  expirationDate  DateTime?
  name            String?
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  description  String?
  unitPrice    Float
  total        Float     @default(0)
  discount  Float   @default(0)

  @@index([quoteId])
  @@index([productId])
}

model Invoice {
  id          String    @id @default(uuid())
  number      String    @unique
  status      String    @default("Draft") // Draft, Sent, Paid, Overdue
  tax         Float     @default(0)
  notes       String?
  dueDate     DateTime?
  paidDate    DateTime?
  payMethod   String?   // Wire Transfer, Credit Card, Check, ACH, PayPal
  quoteId     String?
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items InvoiceItem[]
  subtotal    Float     @default(0)
  total       Float     @default(0)
  terms       String?
  date        DateTime  @default(now())

  @@index([quoteId])
  @@index([accountId])
  @@index([contactId])
  deletedAt   DateTime?

  totalAmount     Float    @default(0)
  invoiceNumber   String?
  // The subscription this invoice bills, for its invoice history.
  subscriptionId  String?

  @@index([subscriptionId])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  description  String?
  unitPrice    Float
  total        Float     @default(0)

  @@index([invoiceId])
  @@index([productId])
}

// ─── WORKFLOWS ───

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  module      String   // contacts, leads, deals, cases, etc.
  trigger     String   // create, update, statusChange
  conditions  Json?    // Array of { field, operator, value }
  actions     Json?    // Array of { type, config }
  active      Boolean  @default(true)
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs WorkflowLog[]
  lastRun DateTime?

}

model WorkflowLog {
  id           String   @id @default(uuid())
  workflowId   String
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowName String
  module       String
  trigger      String
  recordId     String
  actionsRun   String[]
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  @@index([workflowId])
}

// ─── CUSTOM FIELDS ───

model CustomField {
  id       String  @id @default(uuid())
  module   String  // contacts, leads, deals, accounts, activities, cases
  name     String
  fieldKey String  @unique
  type     String  @default("text") // text, number, select, date, url, email, textarea
  options  String? // Comma-separated for select fields
  required Boolean @default(false)
  createdAt DateTime @default(now())

  values CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String
  // Polymorphic relations
  recordId String
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  caseId     String?
  case       Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Written by the routes, never migrated until now.
  module String?

  @@index([customFieldId])
  @@index([recordId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([accountId])
  @@index([activityId])
  @@index([caseId])
}

// ─── AUDIT & NOTIFICATIONS ───

model AuditLog {
  id       String   @id @default(uuid())
  action   String   // create, update, delete, login, logout
  module   String
  recordId String?
  details  String?
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([userId])
}

model Notification {
  id       String   @id @default(uuid())
  title    String
  message  String
  read     Boolean  @default(false)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordModule String?
  recordId     String?
  createdAt DateTime @default(now())
}

// ─── ADMIN CONFIG ───

model AdminConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
  description String?
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════
// ─── FORECASTING ───
// ═══════════════════════════════════════

model Forecast {
  id           String   @id @default(uuid())
  name         String
  period       String   // Q1-2026, Q2-2026, etc.
  periodStart  DateTime
  periodEnd    DateTime
  quotaAmount  Float    @default(0)
  userId       String
  user         User     @relation("ForecastUser", fields: [userId], references: [id])
  ownerId      String?
  owner        User?    @relation("ForecastOwner", fields: [ownerId], references: [id])
  territoryId  String?
  territory    Territory? @relation(fields: [territoryId], references: [id])
  status       String   @default("Open") // Open, Submitted, Approved, Closed
  bestCase     Float    @default(0)
  commit       Float    @default(0)
  pipeline     Float    @default(0)
  closed       Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items ForecastItem[]

  @@index([ownerId])
}

model ForecastItem {
  id          String   @id @default(uuid())
  forecastId  String
  forecast    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category    String   @default("Pipeline") // Closed, Commit, Best Case, Pipeline, Omitted
  amount      Float    @default(0)
  probability Int      @default(0)
  closeDate   DateTime?
  notes       String?
  overrideAmount Float? // Manager override
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([forecastId])
  @@index([dealId])
}

// ═══════════════════════════════════════
// ─── CPQ (Configure-Price-Quote) ───
// ═══════════════════════════════════════

model ProductBundle {
  id          String   @id @default(uuid())
  name        String
  description String?
  active      Boolean  @default(true)
  minItems    Int      @default(1)
  maxItems    Int?
  discount    Float    @default(0) // Bundle discount %
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ProductBundleItem[]
}

model ProductBundleItem {
  id        String  @id @default(uuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
