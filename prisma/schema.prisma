  // Written by the routes, never migrated until now.
  contractId String?
  method String?
  periods Int?

  @@index([subscriptionId])
  @@index([dealId])
}

model RevenueScheduleEntry {
  id          String    @id @default(uuid())
  scheduleId  String
  schedule    RevenueSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
