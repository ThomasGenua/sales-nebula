model ApprovalProcessStep {
  id               String  @id @default(uuid())
  processId        String
  process          ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  name             String
  approverType     String  @default("user") // user, role, manager, queue
  approverId       String? // userId or roleId depending on type
  stepOrder Int @default(0)

  @@index([processId])
}

model ApprovalRequest {
  id            String   @id @default(uuid())
