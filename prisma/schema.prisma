// ═══════════════════════════════════════
// FLOW BUILDER (Visual Workflow)
// ═══════════════════════════════════════

model FlowDefinition {
  id          String  @id @default(uuid())
  name        String
  description String?
  module      String?
  type        String  @default("RecordTriggered") // RecordTriggered, ScreenFlow, Scheduled, AutoLaunched
  status      String  @default("Draft") // Draft, Active, Inactive
  version     Int     @default(1)
  triggerType String? // create, update, delete
  triggerConditions Json?
  canvas      Json    // {nodes: [{id, type, position, config}], edges: [{source, target, condition}]}
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions FlowVersion[]
  runs     FlowRun[]
  // Written by the routes, never migrated until now.
  publishedAt DateTime?
  publishedById String?

  @@index([module])
  @@index([status])
}

model FlowVersion {
  id           String @id @default(uuid())
  flowId       String
  flow         FlowDefinition @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version      Int
  canvas       Json
  publishedAt  DateTime?
  publishedById String?
  createdAt    DateTime @default(now())

  @@unique([flowId, version])
}

model FlowRun {
  id          String    @id @default(uuid())
  flowId      String
  flow        FlowDefinition @relation(fields: [flowId], references: [id])
  status      String    @default("Running") // Running, Completed, Failed, Paused
  triggerRecordId String?
  triggerModule String?
  context     Json?     // runtime variables
  log         Json?     // execution trace
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  @@index([flowId])
  @@index([status])
}

// ═══════════════════════════════════════
// CUSTOM OBJECTS (Dynamic Schema)
// ═══════════════════════════════════════

model CustomObject {
  id           String  @id @default(uuid())
  apiName      String  @unique // my_custom_object__c
  label        String
  pluralLabel  String
  description  String?
  iconName     String?
  allowActivities Boolean @default(true)
  allowReports Boolean @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fields  CustomObjectField[]
  records CustomObjectRecord[]
  deletedAt   DateTime?

}

model CustomObjectField {
  id          String  @id @default(uuid())
  objectId    String
  object      CustomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  apiName     String  // field_name__c
  label       String
  type        String  @default("Text") // Text, Number, Currency, Date, DateTime, Checkbox, Picklist, Lookup, Formula, Email, Phone, URL, TextArea, RichText
  required    Boolean @default(false)
  unique      Boolean @default(false)
  defaultValue String?
  picklistValues String[] @default([])
  lookupObject String?   // for Lookup type
  formulaExpression String? // for Formula type
  length      Int?
  precision   Int?
  scale       Int?
  description String?
  sortOrder   Int     @default(0)

  @@unique([objectId, apiName])
  @@index([objectId])
}

model CustomObjectRecord {
  id        String  @id @default(uuid())
  objectId  String
  object    CustomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  data      Json    // flexible key-value store
  ownerId   String?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectId])
  @@index([ownerId])
}

