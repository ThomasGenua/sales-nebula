  startAt        DateTime
  endAt          DateTime
  allDay         Boolean   @default(false)
  timezone       String    @default("UTC")

  // Recurrence (RFC 5545 RRULE)
  isRecurring    Boolean   @default(false)
  rrule          String?   // FREQ=WEEKLY;INTERVAL=1;BYDAY=MO,WE;COUNT=10
  recurrenceEnd  DateTime?
  parentEventId  String?   // set on materialized exceptions
  parentEvent    CalendarEvent?  @relation("EventRecurrence", fields: [parentEventId], references: [id], onDelete: Cascade)
  exceptions     CalendarEvent[] @relation("EventRecurrence")
  originalStart  DateTime? // for a modified occurrence, the slot it replaces
  isException    Boolean   @default(false)
  isCancelled    Boolean   @default(false)

  // Linkage
  ownerId        String?
  accountId      String?
  contactId      String?
  dealId         String?
  caseId         String?
  leadId         String?
  parentModule   String?
  parentId       String?

  visibility     String    @default("Default") // Default, Public, Private, Confidential
  color          String?
  meetingUrl     String?
  externalUid    String?   @unique // for iCal round-trip / external sync

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  invitees       EventInvitee[]
  reminders      Reminder[]
  bookings       ResourceBooking[]

  @@index([ownerId])
  @@index([startAt])
  @@index([endAt])
  @@index([eventType])
  @@index([parentEventId])
  @@index([parentModule, parentId])
  @@index([startAt, endAt])
}

model EventInvitee {
  id           String    @id @default(uuid())
  eventId      String
  event        CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String?
  contactId    String?
  leadId       String?
  email        String?
  name         String?
  role         String    @default("Required") // Required, Optional, Chair, NonParticipant
  responseStatus String  @default("NeedsAction") // NeedsAction, Accepted, Declined, Tentative, Delegated
  respondedAt  DateTime?
  comment      String?
  isOrganizer  Boolean   @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([eventId])
  @@index([userId])
  @@index([contactId])
  @@index([responseStatus])
}

model Reminder {
  id           String    @id @default(uuid())
  eventId      String?
  event        CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activityId   String?
  userId       String
  method       String    @default("Popup") // Popup, Email, SMS, Push
  minutesBefore Int      @default(15)
  triggerAt    DateTime
  status       String    @default("Pending") // Pending, Sent, Dismissed, Snoozed, Failed
  sentAt       DateTime?
  dismissedAt  DateTime?
  snoozedUntil DateTime?
  message      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
  @@index([triggerAt])
  @@index([eventId])
}

model CalendarResource {
  id           String    @id @default(uuid())
  name         String
  resourceType String    @default("Room") // Room, Equipment, Vehicle, Person
  description  String?
  location     String?
  capacity     Int?
  active       Boolean   @default(true)
  requiresApproval Boolean @default(false)
  approverId   String?
  costPerHour  Float?
  attributes   Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bookings     ResourceBooking[]

  @@index([resourceType])
  @@index([active])
}

model ResourceBooking {
  id           String    @id @default(uuid())
  resourceId   String
  resource     CalendarResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  eventId      String?
  event        CalendarEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  bookedById   String
  startAt      DateTime
  endAt        DateTime
  status       String    @default("Confirmed") // Pending, Confirmed, Rejected, Cancelled
  purpose      String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([resourceId, startAt])
  @@index([eventId])
  @@index([bookedById])
  @@index([status])
}

model CalendarFeed {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique
  name        String    @default("My Calendar")
  eventTypes  Json?     // filter which types are published
  includeDeclined Boolean @default(false)
  active      Boolean   @default(true)
  lastAccessAt DateTime?
  accessCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([token])
}

model WorkingHours {
  id          String   @id @default(uuid())
  userId      String?  // null = org default
  dayOfWeek   Int      // 0=Sunday .. 6=Saturday
  startMinute Int      @default(540)  // 09:00
  endMinute   Int      @default(1020) // 17:00
  isWorkingDay Boolean @default(true)
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model BusinessHours {
  id           String   @id @default(uuid())
  name         String
  timezone     String   @default("UTC")
  isDefault    Boolean  @default(false)
  active       Boolean  @default(true)
  schedule     Json?    // [{dayOfWeek, openMinute, closeMinute, closed}]
  holidays     Json?    // [{date, name}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([isDefault])
}

// ═══════════════════════════════════════════════════════════════
// TIER 1B: PROJECT MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model Project {
  id             String    @id @default(uuid())
  name           String
  code           String?
  description    String?
  status         String    @default("Draft") // Draft, Planning, Active, OnHold, Completed, Cancelled
  priority       String    @default("Medium")
  health         String    @default("Green") // Green, Amber, Red
  startDate      DateTime?
  endDate        DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  percentComplete Int      @default(0)
  budget         Float?
  actualCost     Float     @default(0)
  estimatedHours Float?
  actualHours    Float     @default(0)
  currency       String    @default("USD")

  managerId      String?
  ownerId        String?
  accountId      String?
  dealId         String?
  contactId      String?
  templateId     String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tasks          ProjectTask[]
  milestones     ProjectMilestone[]
  resources      ProjectResource[]
  timeEntries    TimeEntry[]

  @@index([status])
  @@index([managerId])
  @@index([accountId])
  @@index([startDate, endDate])
}

model ProjectTask {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  status          String    @default("NotStarted") // NotStarted, InProgress, Blocked, Completed, Cancelled
  priority        String    @default("Medium")
  taskType        String    @default("Task") // Task, Milestone, Summary, Phase

  startDate       DateTime?
  endDate         DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  durationDays    Float?
  percentComplete Int       @default(0)
  estimatedHours  Float?
  actualHours     Float     @default(0)

  // Hierarchy and ordering
  parentTaskId    String?
  parentTask      ProjectTask?  @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks        ProjectTask[] @relation("TaskHierarchy")
  sortOrder       Int       @default(0)
  wbsCode         String?   // 1.2.3

  assignedToId    String?
  milestoneId     String?
  isCriticalPath  Boolean   @default(false)
  slackDays       Float?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  predecessors    TaskDependency[] @relation("SuccessorTask")
  successors      TaskDependency[] @relation("PredecessorTask")
  timeEntries     TimeEntry[]

  @@index([projectId])
  @@index([parentTaskId])
  @@index([assignedToId])
  @@index([status])
  @@index([startDate, endDate])
}

model TaskDependency {
  id             String   @id @default(uuid())
  predecessorId  String
  predecessor    ProjectTask @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId    String
  successor      ProjectTask @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)
  dependencyType String   @default("FS") // FS finish-to-start, SS, FF, SF
  lagDays        Float    @default(0)
  createdAt      DateTime @default(now())

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  status      String    @default("Pending") // Pending, AtRisk, Completed, Missed
  isBillable  Boolean   @default(false)
  amount      Float?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([dueDate])
}

model ProjectResource {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  role          String   @default("Member")
  allocationPct Int      @default(100)
  hourlyRate    Float?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model TimeEntry {
  id          String    @id @default(uuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId      String
  entryDate   DateTime
  hours       Float
  description String?
  billable    Boolean   @default(true)
  billed      Boolean   @default(false)
  hourlyRate  Float?
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([taskId])
  @@index([userId, entryDate])
}

model ProjectTemplate {
  id             String    @id @default(uuid())
  name           String
  description    String?
  category       String?
  defaultDurationDays Int?
  estimatedHours Float?
  active         Boolean   @default(true)
  usageCount     Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  taskTemplates  TaskTemplate[]

  @@index([active])
}

model TaskTemplate {
  id                String   @id @default(uuid())
  projectTemplateId String
  projectTemplate   ProjectTemplate @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  taskType          String   @default("Task")
  offsetDays        Int      @default(0)   // days from project start
  durationDays      Float    @default(1)
  estimatedHours    Float?
  defaultRole       String?
  sortOrder         Int      @default(0)
  parentKey         String?  // template-local grouping key
  templateKey       String?  // referenced by dependsOnKeys
  dependsOnKeys     Json?    // ["key1","key2"]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectTemplateId])
}

// ═══════════════════════════════════════════════════════════════
// TIER 1C: SECURITY GROUPS (row-level access control)
// ═══════════════════════════════════════════════════════════════

model SecurityGroup {
  id             String    @id @default(uuid())
  name           String    @unique
  description    String?
  isNonInheritable Boolean @default(false)
  isPrimaryGroup Boolean   @default(false)
  autoAssign     Boolean   @default(false) // auto-add new records owned by members
  active         Boolean   @default(true)

  parentGroupId  String?
  parentGroup    SecurityGroup?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups    SecurityGroup[] @relation("GroupHierarchy")

  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  members        SecurityGroupUser[]
  records        SecurityGroupRecord[]
  roleLinks      SecurityGroupRole[]

  @@index([active])
  @@index([parentGroupId])
}

model SecurityGroupUser {
  id              String   @id @default(uuid())
  securityGroupId String
  securityGroup   SecurityGroup @relation(fields: [securityGroupId], references: [id], onDelete: Cascade)
  userId          String
  isGroupAdmin    Boolean  @default(false)
  primaryGroup    Boolean  @default(false)
  addedById       String?
  createdAt       DateTime @default(now())

  @@unique([securityGroupId, userId])
  @@index([userId])
  @@index([securityGroupId])
}

model SecurityGroupRecord {
  id              String   @id @default(uuid())
  securityGroupId String
  securityGroup   SecurityGroup @relation(fields: [securityGroupId], references: [id], onDelete: Cascade)
  module          String
  recordId        String
  accessLevel     String   @default("Full") // Read, Edit, Full
  assignedById    String?
  createdAt       DateTime @default(now())

  @@unique([securityGroupId, module, recordId])
  @@index([module, recordId])
  @@index([securityGroupId])
}

model SecurityGroupRole {
  id              String   @id @default(uuid())
  securityGroupId String
  securityGroup   SecurityGroup @relation(fields: [securityGroupId], references: [id], onDelete: Cascade)
  roleId          String
  createdAt       DateTime @default(now())

  @@unique([securityGroupId, roleId])
  @@index([roleId])
}

model SecurityGroupRule {
  id              String   @id @default(uuid())
  name            String
  module          String
  conditions      Json?    // [{field, operator, value}]
  securityGroupId String
  active          Boolean  @default(true)
  priority        Int      @default(0)
  applyOnCreate   Boolean  @default(true)
  applyOnUpdate   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([module, active])
}

// ═══════════════════════════════════════════════════════════
// TIER 2 — FAVORITES & TRACKERS
// ═══════════════════════════════════════════════════════════

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  module     String
  recordId   String
  recordName String?
  recordUrl  String?
  sortOrder  Int      @default(0)
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, module, recordId])
  @@index([userId, module])
  @@index([userId, pinned])
}

model RecentlyViewed {
  id         String   @id @default(uuid())
  userId     String
  module     String
  recordId   String
  recordName String?
  action     String   @default("view") // view, edit, create
  viewCount  Int      @default(1)
  firstSeen  DateTime @default(now())
  viewedAt   DateTime @default(now())

  @@unique([userId, module, recordId])
  @@index([userId, viewedAt])
  @@index([module, recordId])
}

model ViewStat {
  id         String   @id @default(uuid())
  module     String
  recordId   String
  totalViews Int      @default(0)
  uniqueUsers Int     @default(0)
  lastViewedAt DateTime @default(now())

  @@unique([module, recordId])
  @@index([module, totalViews])
}

// ═══════════════════════════════════════════════════════════
// TIER 2 — FULL-TEXT SEARCH INDEX
// ═══════════════════════════════════════════════════════════

model SearchIndex {
  id         String    @id @default(uuid())
  module     String
  recordId   String
  title      String
  subtitle   String?
  body       String?
  tokens     String    // normalized whitespace-delimited token stream
  tokenCount Int       @default(0)
  keywords   String?
  ownerId    String?
  status     String?
  boost      Float     @default(1.0)
  recordUpdatedAt DateTime?
  indexedAt  DateTime  @default(now())
  deletedAt  DateTime?

  postings   SearchPosting[]

  @@unique([module, recordId])
  @@index([module])
  @@index([indexedAt])
}

model SearchPosting {
  id         String      @id @default(uuid())
  indexId    String
  index      SearchIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  term       String
  field      String      @default("body") // title, subtitle, body, keywords
  frequency  Int         @default(1)
  positions  String?     // comma separated ordinals for phrase matching

  @@index([term])
  @@index([indexId])
  @@index([term, field])
}

model SearchTermStat {
  id        String   @id @default(uuid())
  term      String   @unique
  docCount  Int      @default(0)
  totalFreq Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([docCount])
}

model SearchSynonym {
  id        String   @id @default(uuid())
  term      String
  synonym   String
  twoWay    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([term, synonym])
  @@index([term])
}

model SearchQueryLog {
  id            String   @id @default(uuid())
  userId        String?
  query         String
  normalized    String?
  resultCount   Int      @default(0)
  durationMs    Int      @default(0)
  clickedModule String?
  clickedRecordId String?
  clickedRank   Int?
  createdAt     DateTime @default(now())

  @@index([normalized])
  @@index([createdAt])
}

model SearchIndexQueue {
  id        String   @id @default(uuid())
  module    String
  recordId  String
  operation String   @default("upsert") // upsert, delete
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@unique([module, recordId, operation])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// TIER 2 — INBOUND EMAIL (IMAP / POP3)
// ═══════════════════════════════════════════════════════════

model InboundEmailAccount {
  id                String    @id @default(uuid())
  name              String
  provider          String    @default("imap") // imap, pop3, microsoft
  protocol          String    @default("imap") // imap, pop3
  host              String?
  port              Int       @default(993)
  useTls            Boolean   @default(true)
  username          String
  password          String?   // stored encrypted at rest

  // Microsoft Graph mailboxes authenticate with OAuth, not a password.
  mailboxAddress    String?   // the UPN the messages belong to
  tenantId          String?
  oauthRefreshToken String?   // encrypted at rest
  oauthAccessToken  String?   // encrypted at rest, short lived
  oauthExpiresAt    DateTime?
  lastSyncAt        DateTime?
  mailbox           String    @default("INBOX")
  pollIntervalMinutes Int     @default(5)
  status            String    @default("Idle") // Idle, Polling, Error, Disabled
  lastPolledAt      DateTime?
  lastUid           Int       @default(0)
  lastError         String?
  autoCreateCase    Boolean   @default(true)
  autoCreateLead    Boolean   @default(false)
  autoReply         Boolean   @default(false)
  autoReplyTemplateId String?
  defaultOwnerId    String?
  defaultTeamId     String?
  defaultCaseType   String?
  defaultPriority   String    @default("Medium")
  markSeen          Boolean   @default(true)
  deleteAfterImport Boolean   @default(false)
  maxMessagesPerPoll Int      @default(50)
  allowedSenders    String?   // comma separated allowlist
  blockedSenders    String?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  messages InboundEmailMessage[]
  rules    InboundRoutingRule[]
  pollLogs EmailPollLog[]

  @@index([active])
}

model InboundEmailMessage {
  id             String    @id @default(uuid())
  accountId      String
  account        InboundEmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  uid            Int?
  externalId     String?   // the provider's message id (Graph), for in-thread replies
  repliedAt      DateTime?
  messageId      String?
  inReplyTo      String?
  references     String?
  threadKey      String?
  fromEmail      String
  fromName       String?
  toEmails       String?
  ccEmails       String?
  replyTo        String?
  subject        String?
  textBody       String?
  htmlBody       String?
  snippet        String?
  receivedAt     DateTime  @default(now())
  sizeBytes      Int       @default(0)
  flags          String?
  hasAttachments Boolean   @default(false)
  isAutomated    Boolean   @default(false)
  attachmentCount Int      @default(0)
  status         String    @default("New") // New, Processed, Ignored, Failed, Duplicate
  matchedModule  String?
  matchedRecordId String?
  createdCaseId  String?
  createdLeadId  String?
  appliedRuleId  String?
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  attachments InboundEmailAttachment[]

  @@unique([accountId, uid])
  @@index([accountId, status])
  @@index([threadKey])
  @@index([fromEmail])
  @@index([messageId])
}

model InboundEmailAttachment {
  id          String   @id @default(uuid())
  messageId   String
  message     InboundEmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  contentType String?
  sizeBytes   Int      @default(0)
  contentId   String?
  inline      Boolean  @default(false)
  storagePath String?
  documentId  String?
  createdAt   DateTime @default(now())

  @@index([messageId])
}

model InboundRoutingRule {
  id            String    @id @default(uuid())
  accountId     String?
  account       InboundEmailAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  priority      Int       @default(100)
  conditions    Json      // [{field, operator, value}]
  matchType     String    @default("all") // all, any
  action        String    @default("createCase") // createCase, createLead, assign, tag, ignore, forward, linkToRecord
  targetModule  String?
  assignToId    String?
  assignToTeamId String?
  setPriority   String?
  setType       String?
  addTags       String?
  forwardTo     String?
  stopProcessing Boolean  @default(true)
  matchCount    Int       @default(0)
  lastMatchedAt DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  // Written by the routes, never migrated until now.
  setStatus String?

  @@index([accountId, priority])
  @@index([active])
}

model EmailPollLog {
  id                String    @id @default(uuid())
  accountId         String
  account           InboundEmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  durationMs        Int       @default(0)
  messagesFetched   Int       @default(0)
  messagesProcessed Int       @default(0)
  casesCreated      Int       @default(0)
  leadsCreated      Int       @default(0)
  errorCount        Int       @default(0)
  status            String    @default("Running") // Running, Success, PartialFailure, Failed
  error             String?

  @@index([accountId, startedAt])
}

// ═══════════════════════════════════════════════════════════
// TIER 2 — GEOCODING & TERRITORY MAPPING
// ═══════════════════════════════════════════════════════════

model GeocodeCache {
  id               String    @id @default(uuid())
  addressHash      String    @unique
  rawAddress       String
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  street           String?
  city             String?
  region           String?
  postalCode       String?
  country          String?
  countryCode      String?
  accuracy         String?   // rooftop, interpolated, centroid, approximate
  provider         String    @default("manual")
  confidence       Float     @default(0)
  failed           Boolean   @default(false)
  hitCount         Int       @default(0)
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime?

  @@index([latitude, longitude])
  @@index([city])
}

model MapArea {
  id          String    @id @default(uuid())
  name        String
  description String?
  type        String    @default("Territory") // Territory, Zone, Region, ServiceArea, Custom
  shape       String    @default("polygon")   // polygon, circle, rectangle
  polygon     Json?     // [{lat, lng}, ...]
  centerLat   Float?
  centerLng   Float?
  radiusKm    Float?
  minLat      Float?
  maxLat      Float?
  minLng      Float?
  maxLng      Float?
  areaSqKm    Float?
  color       String    @default("#F5A623")
  fillOpacity Float     @default(0.25)
  territoryId String?
  parentAreaId String?
  parentArea  MapArea?  @relation("MapAreaHierarchy", fields: [parentAreaId], references: [id])
  childAreas  MapArea[] @relation("MapAreaHierarchy")
  assignedUserId String?
  priority    Int       @default(100)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  markers MapMarker[]

  @@index([territoryId])
  @@index([minLat, maxLat])
  @@index([parentAreaId])
}

model MapMarker {
  id          String    @id @default(uuid())
  module      String
  recordId    String
  label       String
  sublabel    String?
  latitude    Float
  longitude   Float
  geohash     String?
  markerType  String    @default("default")
  color       String    @default("#F5A623")
  icon        String?
  addressHash String?
  areaId      String?
  area        MapArea?  @relation(fields: [areaId], references: [id])
  ownerId     String?
  meta        Json?
  stale       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([module, recordId])
  @@index([latitude, longitude])
  @@index([geohash])
  @@index([module])
  @@index([areaId])
}

model MapLayer {
  id           String   @id @default(uuid())
  name         String
  module       String
  description  String?
  filterJson   Json?
  markerColor  String   @default("#F5A623")
  markerIcon   String?
  labelField   String?
  visible      Boolean  @default(true)
  sortOrder    Int      @default(0)
  ownerId      String?
  isShared     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([module])
}

// ═══════════════════════════════════════════════════════════
// TIER 2 — PROSPECTS & TARGET LISTS
// ═══════════════════════════════════════════════════════════

model Prospect {
  id             String    @id @default(uuid())
  salutation     String?
  firstName      String?
  lastName       String
  fullName       String?
  title          String?
  department     String?
  accountName    String?
  email          String?
  altEmail       String?
  phoneWork      String?
  phoneMobile    String?
  phoneOther     String?
  fax            String?
  website        String?
  linkedIn       String?
  street         String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  latitude       Float?
  longitude      Float?
  source         String?   // Import, WebForm, Purchased List, Event, Referral
  sourceDetail   String?
  status         String    @default("New") // New, Contacted, Qualified, Converted, Dead
  score          Int       @default(0)
  industry       String?
  employeeCount  Int?
  annualRevenue  Float?
  description    String?
  emailOptOut    Boolean   @default(false)
  doNotCall      Boolean   @default(false)
  invalidEmail   Boolean   @default(false)
  bouncedCount   Int       @default(0)
  lastContactedAt DateTime?
  ownerId        String?
  convertedLeadId String?
  convertedContactId String?
  convertedAt    DateTime?
  duplicateOfId  String?
  externalId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  listEntries ProspectListEntry[]

  @@index([email])
  @@index([status])
  @@index([ownerId])
  @@index([lastName, firstName])
}

model ProspectList {
  id            String    @id @default(uuid())
  name          String
  description   String?
  type          String    @default("Static") // Static, Dynamic, Suppression, Seed, Test
  entityModule  String    @default("Prospect") // Prospect, Lead, Contact, Account
  filterJson    Json?
  memberCount   Int       @default(0)
  activeCount   Int       @default(0)
  optedOutCount Int       @default(0)
  lastBuiltAt   DateTime?
  buildDurationMs Int     @default(0)
  ownerId       String?
  isShared      Boolean   @default(false)
  campaignId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  entries ProspectListEntry[]
  // Written by the routes, never migrated until now. A list's purpose is its
  // type; whether it is rebuilt from filterJson is a separate switch.
  isDynamic Boolean   @default(false)

  @@index([type])
  @@index([ownerId])
  @@index([campaignId])
}

model ProspectListEntry {
  id          String       @id @default(uuid())
  listId      String
  list        ProspectList @relation(fields: [listId], references: [id], onDelete: Cascade)
  prospectId  String?
  prospect    Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  leadId      String?
  contactId   String?
  accountId   String?
  email       String?
  name        String?
  entityModule String      @default("Prospect")
  status      String       @default("Active") // Active, Removed, Suppressed, Bounced, OptedOut
  addedBy     String?
  addedVia    String       @default("manual") // manual, filter, import, api
  addedAt     DateTime     @default(now())
  removedAt   DateTime?

  @@unique([listId, entityModule, prospectId, leadId, contactId, accountId])
  @@index([listId, status])
  @@index([email])
  @@index([prospectId])
}

model EmailSuppression {
  id          String   @id @default(uuid())
  email       String   @unique
  reason      String   @default("Unsubscribe") // Unsubscribe, HardBounce, Complaint, Manual, Invalid
  source      String?
  campaignId  String?
  notes       String?
  suppressedAt DateTime @default(now())
  expiresAt   DateTime?
  // Written by the routes, never migrated until now.
  addedById String?

  @@index([reason])
}

// ═══════════════════════════════════════════════════════════
// TIER 2 — BUGS & RELEASES
// ═══════════════════════════════════════════════════════════

model Release {
  id           String    @id @default(uuid())
  name         String    @unique
  version      String?
  status       String    @default("Planned") // Planned, InDevelopment, CodeFreeze, Testing, Released, Deprecated
  releaseDate  DateTime?
  targetDate   DateTime?
  description  String?
  releaseNotes String?
  sortOrder    Int       @default(0)
  isCurrent    Boolean   @default(false)
  ownerId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  foundBugs Bug[] @relation("BugFoundIn")
  fixedBugs Bug[] @relation("BugFixedIn")

  @@index([status])
  @@index([sortOrder])
}

model Bug {
  id            String    @id @default(uuid())
  bugNumber     String    @unique
  title         String
  description   String?
  status        String    @default("New") // New, Assigned, InProgress, Pending, Resolved, Closed, Rejected, Duplicate
  priority      String    @default("Medium") // Urgent, High, Medium, Low
  severity      String    @default("Minor")  // Blocker, Critical, Major, Minor, Cosmetic
  type          String    @default("Defect") // Defect, FeatureRequest, Enhancement, Question
  source        String?   // Internal, Customer, QA, Automated, Partner
  resolution    String?   // Fixed, WontFix, Duplicate, CannotReproduce, WorksAsDesigned, Deferred
  category      String?
  component     String?
  stepsToReproduce String?
  expectedBehavior String?
  actualBehavior   String?
  environment   String?
  workLog       String?
  foundInReleaseId String?
  foundInRelease Release? @relation("BugFoundIn", fields: [foundInReleaseId], references: [id])
  fixedInReleaseId String?
  fixedInRelease Release? @relation("BugFixedIn", fields: [fixedInReleaseId], references: [id])
  assignedToId  String?
  reportedById  String?
  accountId     String?
  contactId     String?
  caseId        String?
  productId     String?
  duplicateOfId String?
  parentBugId   String?
  parentBug     Bug?      @relation("BugHierarchy", fields: [parentBugId], references: [id])
  subBugs       Bug[]     @relation("BugHierarchy")
  votes         Int       @default(0)
  reopenCount   Int       @default(0)
  estimatedHours Float?
  actualHours   Float?
  dueDate       DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  firstResponseAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  comments BugComment[]
  watchers BugWatcher[]
  history  BugHistory[]
  fixedAt     DateTime?
  verifiedAt  DateTime?

  @@index([status])
  @@index([assignedToId])
  @@index([priority, severity])
  @@index([fixedInReleaseId])
  @@index([caseId])
}

model BugComment {
  id         String   @id @default(uuid())
  bugId      String
  bug        Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  userId     String?
  authorName String?
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@index([bugId])
}

model BugWatcher {
  id        String   @id @default(uuid())
  bugId     String
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  userId    String
  notifyOn  String   @default("all") // all, statusChange, comment, resolution
  createdAt DateTime @default(now())

  @@unique([bugId, userId])
  @@index([userId])
}

model BugHistory {
  id        String   @id @default(uuid())
  bugId     String
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  userId    String?
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([bugId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// TIER 1 REMAINDER — PDF TEMPLATES
// ═══════════════════════════════════════════════════════════

model PdfTemplate {
  id            String    @id @default(uuid())
  name          String
  description   String?
  module        String    // quotes, invoices, contracts, orders, cases, accounts
  templateType  String    @default("Document")
  bodyHtml      String    // markup with {{merge.fields}}
  headerHtml    String?
  footerHtml    String?
  css           String?
  pageSize      String    @default("A4")
  orientation   String    @default("portrait")
  marginTop     Int       @default(20)
  marginRight   Int       @default(15)
  marginBottom  Int       @default(20)
  marginLeft    Int       @default(15)
  isDefault     Boolean   @default(false)
  active        Boolean   @default(true)
  locale        String    @default("en")
  usageCount    Int       @default(0)
  lastUsedAt    DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  renders       PdfRender[]

  @@index([module, active])
  @@index([isDefault])
}

model PdfRender {
  id          String   @id @default(uuid())
  templateId  String
  template    PdfTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  module      String
  recordId    String
  fileName    String
  storagePath String?
  sizeBytes   Int      @default(0)
  renderedById String?
  durationMs  Int      @default(0)
  status      String   @default("Success")
  error       String?
  createdAt   DateTime @default(now())

  @@index([templateId])
  @@index([module, recordId])
}

// ═══════════════════════════════════════════════════════════
// TIER 1 REMAINDER — STUDIO (runtime field builder)
// ═══════════════════════════════════════════════════════════

model CustomFieldDef {
  id            String    @id @default(uuid())
  module        String
  name          String    // storage key, e.g. contract_tier
  label         String
  fieldType     String    // text, textarea, number, currency, date, datetime, boolean, picklist, multiselect, url, email, phone, percent, relate, formula
  description   String?
  helpText      String?
  required      Boolean   @default(false)
  unique        Boolean   @default(false)
  defaultValue  String?
  maxLength     Int?
  minValue      Float?
  maxValue      Float?
  precision     Int       @default(2)
  picklistId    String?
  relatedModule String?
  formula       String?
  regex         String?
  regexMessage  String?
  auditable     Boolean   @default(false)
  reportable    Boolean   @default(true)
  searchable    Boolean   @default(false)
  readOnly      Boolean   @default(false)
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([module, name])
  @@index([module, active])
}

model Picklist {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  description String?
  isGlobal    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  values      PicklistValue[]
}

model PicklistValue {
  id         String   @id @default(uuid())
  picklistId String
  picklist   Picklist @relation(fields: [picklistId], references: [id], onDelete: Cascade)
  value      String
  label      String
  color      String?
  sortOrder  Int      @default(0)
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  parentValue String? // for dependent picklists
  createdAt  DateTime @default(now())

  @@unique([picklistId, value])
  @@index([picklistId, active])
}

model LayoutDef {
  id         String   @id @default(uuid())
  module     String
  viewType   String   @default("detail") // detail, edit, list, quickcreate
  name       String   @default("Default")
  panels     Json?    // [{label, columns, fields:[{name, span, readOnly}]}]
  isDefault  Boolean  @default(false)
  roleId     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([module, viewType, name])
  @@index([module, viewType])
}


// ═══════════════════════════════════════════════════════════
// SLA SUPPORT MODELS
// ═══════════════════════════════════════════════════════════

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model CaseStatusHistory {
  id         String   @id @default(uuid())
  caseId     String
  fromStatus String?
  toStatus   String
  changedById String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([caseId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// PUBLIC SIGNUP AND INVITES
//
// There is no tenancy in this schema: every record lives in one
// shared dataset. A public signup therefore must NOT create a user,
// or strangers land inside live customer data. Signup captures a
// verified request; access is granted only by an admin-issued invite.
// ═══════════════════════════════════════════════════════════

model SignupRequest {
  id             String    @id @default(uuid())
  email          String
  firstName      String?
  lastName       String?
  company        String?
  companySize    String?
  role           String?
  phone          String?
  useCase        String?
  interestedIn   String    @default("cloud") // cloud, self-hosted, both

  status         String    @default("Pending") // Pending, Verified, Approved, Rejected, Converted
  verifyTokenHash String?  @unique
  verifyExpiresAt DateTime?
  verifiedAt     DateTime?

  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  convertedUserId String?
  convertedAt    DateTime?

  source         String?   // landing, referral, campaign id
  utmSource      String?
  utmCampaign    String?
  ipAddress      String?
  userAgent      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model UserInvite {
  id            String    @id @default(uuid())
  email         String
  firstName     String?
  lastName      String?
  roleId        String?
  tokenHash     String    @unique
  expiresAt     DateTime
  status        String    @default("Pending") // Pending, Accepted, Revoked, Expired
  invitedById   String?
  acceptedAt    DateTime?
  acceptedUserId String?
  signupRequestId String?
  message       String?
  resendCount   Int       @default(0)
  lastSentAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([expiresAt])
}
