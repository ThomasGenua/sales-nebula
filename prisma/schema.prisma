  returnType String   @default("text") // text, number, currency, percent, date, boolean
  formula    String   // Expression: e.g. "value * probability / 100" or "DATEDIFF(closeDate, NOW())"
  precision  Int?     // Decimal places for numbers
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

