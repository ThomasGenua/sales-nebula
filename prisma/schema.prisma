// ═══════════════════════════════════════
// ─── REPORTS ───
// ═══════════════════════════════════════

model Report {
  id           String   @id @default(uuid())
  name         String
  description  String?
  module       String   // Primary module: contacts, deals, leads, accounts, etc.
  reportType   String   @default("tabular") // tabular, summary, matrix, chart
  chartType    String?  // bar, line, pie, donut, funnel, scatter, area
  columns      Json     // Array of column definitions: [{field, label, width, sortable}]
  filters      Json     @default("[]") // [{field, operator, value}]
  groupBy      Json     @default("[]") // Array of group fields
  aggregations Json     @default("[]") // [{field, function}] - sum, avg, count, min, max
  sortBy       Json     @default("[]") // [{field, direction}]
  joins        Json     @default("[]") // [{module, field, foreignField}]
  limit        Int?
  isPublic     Boolean  @default(false)
  folderId     String?
  folder       ReportFolder? @relation(fields: [folderId], references: [id])
  schedules    ReportSchedule[]
  createdById  String
  createdBy    User     @relation("ReportsCreated", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([folderId])
  @@index([createdById])
}

model ReportFolder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  reports   Report[]
  createdAt DateTime @default(now())
  @@index([parentId])
}

model ReportSchedule {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cron      String   // Cron expression
  format    String   @default("csv") // csv, json, pdf
  recipients Json    @default("[]") // Array of email addresses
  active    Boolean  @default(true)
  lastRun   DateTime?
  nextRun   DateTime?
  createdAt DateTime @default(now())
  @@index([reportId])
}

// ═══════════════════════════════════════
// ─── FORMULA FIELDS ───
