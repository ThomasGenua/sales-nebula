{
  "name": "sales-nebula-backend",
  "version": "4.5.1",
  "description": "Sales Nebula CRM - Full Stack Backend API",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "node scripts/generate-sqlite-schema.js && prisma generate && prisma generate --schema prisma/schema.sqlite.prisma",
    "dev": "npx nodemon src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test jest --runInBand --forceExit --detectOpenHandles",
    "test:watch": "NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "NODE_ENV=test jest --runInBand --forceExit --coverage",
    "test:reports": "NODE_ENV=test jest --runInBand --forceExit tests/reports.test.js",
    "test:auth": "NODE_ENV=test jest --runInBand --forceExit tests/auth.test.js",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:push:sqlite": "node scripts/generate-sqlite-schema.js && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma db push --force-reset && node prisma/seed.js",
    "setup": "npm install && cp -n .env.example .env 2>/dev/null; npx prisma generate && npx prisma db push && node prisma/seed.js && npm run build:frontend",
    "setup:prod": "npm install --production && npx prisma generate && npx prisma migrate deploy",
    "swagger": "node scripts/generate-swagger.js",
    "setup:docker": "docker-compose up -d",
    "build:frontend": "cd frontend && npm install && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && node scripts/module-manifest.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.14.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.0",
    "socket.io": "^4.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/prisma/"
    ],
    "testTimeout": 30000
  }
}
