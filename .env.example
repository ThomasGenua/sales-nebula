# Database (REQUIRED)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salesnebula?schema=public"
# In production the API retries PostgreSQL this many times, then exits rather
# than starting on a local SQLite file. ALLOW_SQLITE_FALLBACK=true permits the
# fallback in production (single-machine demos only).
# DB_CONNECT_ATTEMPTS=5
# ALLOW_SQLITE_FALLBACK=false

# Auth
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=7544
NODE_ENV=development
# One origin, or several separated by commas; emailed links use the first.
FRONTEND_URL=http://localhost:7544

# API rate limit per client address (defaults: 1000 requests per 15 minutes)
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_WINDOW_MS=900000

# Redis (optional - app works without it)
REDIS_URL=redis://localhost:6379

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Email (optional — without SMTP_HOST, mail is logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Sales Nebula <noreply@salesnebula.com>"

# AI (optional). The AI endpoints and the copilot call Claude; without a key
# they answer 503 and the copilot falls back to rule-based replies. The app
# never read OPENAI_API_KEY, which this file used to list.
ANTHROPIC_API_KEY=
# Model for every AI call. Defaults to claude-opus-5; set e.g. claude-sonnet-5
# for a cheaper, faster model.
# ANTHROPIC_MODEL=claude-opus-5

# Storage (optional - defaults to local filesystem)
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── PUBLIC SIGNUP ───
# This schema has no tenancy: every record lives in one shared dataset.
# Leaving self-registration open would let strangers into live customer data.
# Public signup at /api/signup captures a verified request instead, and an
# administrator issues an invite. Only set this to true if you understand
# that anyone who registers can see everything.
ALLOW_OPEN_REGISTRATION=false

# Shared secret for the email-to-case webhook (/api/public/email-to-case).
# The mail provider sends it as an X-Webhook-Secret header, or as the password
# of HTTP basic auth in the webhook URL. Unset, the webhook answers 503.
EMAIL_TO_CASE_SECRET=

# Secret used to encrypt mailbox passwords and OAuth refresh tokens at rest.
# Falls back to JWT_SECRET if unset.
MAIL_SECRET=

# Microsoft 365 mailbox (inbound email + replies via Graph)
# The app registration needs delegated Mail.Read and Mail.Send, plus
# offline_access so the CRM can refresh without a person present.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:7544/settings/mailboxes/callback
