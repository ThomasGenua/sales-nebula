# Database (REQUIRED)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salesnebula?schema=public"

# Auth
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=7544
NODE_ENV=development
FRONTEND_URL=http://localhost:7544

# Redis (optional - app works without it)
REDIS_URL=redis://localhost:6379

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Email (optional — without SMTP_HOST, mail is logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Sales Nebula <noreply@salesnebula.com>"

# AI (optional)
OPENAI_API_KEY=

# Storage (optional - defaults to local filesystem)
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── PUBLIC SIGNUP ───
# This schema has no tenancy: every record lives in one shared dataset.
# Leaving self-registration open would let strangers into live customer data.
# Public signup at /api/signup captures a verified request instead, and an
# administrator issues an invite. Only set this to true if you understand
# that anyone who registers can see everything.
ALLOW_OPEN_REGISTRATION=false

# Secret used to encrypt mailbox passwords and OAuth refresh tokens at rest.
# Falls back to JWT_SECRET if unset.
MAIL_SECRET=

# Microsoft 365 mailbox (inbound email + replies via Graph)
# The app registration needs delegated Mail.Read and Mail.Send, plus
# offline_access so the CRM can refresh without a person present.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:7544/settings/mailboxes/callback
